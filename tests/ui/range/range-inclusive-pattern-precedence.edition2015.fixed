// In expression, `&a..=b` is treated as `(&a)..=(b)` and `box a..=b` is
// `(box a)..=(b)`. In a pattern, however, `&a..=b` means `&(a..=b)`. This may
// lead to confusion.

//@ run-rustfix
//@ revisions: edition2015 edition2021
//@ [edition2015] edition: 2015..2021
//@ [edition2021] edition: 2021..

#![warn(ellipsis_inclusive_range_patterns)]

pub fn main() {
    match &12 {
        #[cfg(edition2015)]
        &(0..=9) => {}
        //[edition2015]~^ WARN `...` range patterns are deprecated
        //[edition2015]~| WARN this is accepted in the current edition
        //[edition2015]~| HELP use `..=` for an inclusive range
        &(10..=15) => {}
        //~^ ERROR the range pattern here has ambiguous interpretation
        //~| HELP add parentheses to clarify the precedence
        &(16..=20) => {}
        _ => {}
    }
}
